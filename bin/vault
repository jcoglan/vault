#!/usr/bin/env node

'use strict'

const CLI = require('../lib/cli')
const legacy = require('../lib/legacy')
const path = require('path')
const tty = require('tty')

const home = process.env.HOME ||
             process.env.USERPROFILE

const key = process.env.VAULT_KEY ||
            process.env.LOGNAME ||
            process.env.USER ||
            process.env.USERNAME

const vaultPath = process.env.VAULT_PATH || '.vault'
const pathname = path.resolve(home, vaultPath)

let logger = {
  info (...args) {
    console.error('[info]', ...args)
  },
  error (error) {
    console.error('[error]', process.env.DEBUG ? error.stack : error.message)
  }
}

let cli = new CLI({
  config: { path: pathname, key },
  stdout: process.stdout,
  stderr: process.stderr,
  tty:    tty.isatty(1),

  confirm:   require('../lib/cli/confirm'),
  password:  require('../lib/cli/password'),
  selectKey: require('../lib/cli/select_key'),
  sign:      require('../lib/cli/sign')
})

async function main () {
  try {
    await legacy.migrate(logger, pathname, key)
    await cli.run(process.argv.slice(2))
    process.exit(0)
  } catch (error) {
    logger.error(error)
    process.exit(1)
  }
}

main()
